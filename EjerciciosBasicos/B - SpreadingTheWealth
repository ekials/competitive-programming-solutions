#include <iostream>
#include <vector>
#include <cmath>
#include <algorithm>

using namespace std;

int main() 
{
    int n;
    while (cin >> n)
    {
        vector<long long> a(n);
        long long total = 0;
        for (int i = 0; i < n; i++) 
        {
            cin >> a[i];
            total += a[i];
        }

        long long avg = total / n;
        vector<long long> C(n, 0);
        for (int i = 1; i < n; i++) 
        {
            C[i] = C[i - 1] + a[i - 1] - avg;
        }

        sort(C.begin(), C.end());
        long long x1 = C[n / 2];

        long long ans = 0;
        for (int i = 0; i < n; i++) 
        {
            ans += abs(x1 - C[i]);
        }
        cout << ans << "\n";
    }

    return 0;
}